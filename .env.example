# Flask Environment Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# SQLite Persistence Path (inside container or local filesystem)
# For local dev: DATABASE_PATH=data/inventory.db
# For Docker / EC2: DATABASE_PATH=/app/data/inventory.db
DATABASE_PATH=data/inventory.db

# Structured Logging Configuration
# Set to an empty string to log only to stdout, or specify a file path
# For local dev: LOG_FILE_PATH=logs/app.log
# For Docker / EC2: LOG_FILE_PATH=/app/logs/app.log
LOG_FILE_PATH=logs/app.log
LOG_LEVEL=INFO
